# Server
SERVER_PORT=8090

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=my_notifier_bot
MASTER_ADMIN_ID=your_telegram_id

# Database
DB_USERNAME=notifier
DB_PASSWORD=notifier
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifier

# Pushover (optional)
PUSHOVER_ENABLED=false
PUSHOVER_API_TOKEN=your_pushover_api_token

# Logging (optional)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Auth0 REST API (optional - for M2M authentication)
AUTH0_ENABLED=true
AUTH0_ISSUER=https://login.gaynance.com/
AUTH0_AUDIENCE=https://api.notifier.com
