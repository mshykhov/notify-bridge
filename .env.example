# Server
SERVER_PORT=8090

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=my_notifier_bot
MASTER_ADMIN_ID=your_telegram_id

# Database
DB_USERNAME=notifier
DB_PASSWORD=notifier
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifier

# Pushover (optional)
PUSHOVER_ENABLED=false
PUSHOVER_API_TOKEN=your_pushover_api_token
# PUSHOVER_MAX_RETRIES=10
# PUSHOVER_RETRY_DELAY_MS=2000
# PUSHOVER_FAIL_THRESHOLD=3

# Logging (optional)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# LOG_FORMAT: ecs (JSON for k8s/Loki) | none (plain text for local dev)
LOG_FORMAT=none

# Auth0 REST API (required for the default authenticated API)
AUTH0_ENABLED=true
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://api.your-app.com
